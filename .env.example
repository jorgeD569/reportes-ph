# Copiar a .env y completar con valores reales (nunca commitear .env).
# En Render configurar las mismas claves en Environment.

PORT=3000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Sesión firmada (obligatoria, mín. 32 caracteres)
APP_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Duración del token en segundos (recomendado: 30 días)
APP_SESSION_TTL_SECONDS=2592000
# Transición APK: false = compat temporal en POST componentes (solo pendientes)
# true o ausente = exigir Bearer (seguro)
APP_COMPOSICION_REQUIRE_AUTH=false

BUCKET_PDF=your_pdf_bucket
BUCKET_WIKA=your_wika_bucket
BUCKET_ACTIVOS=your_activos_bucket
ADJUNTOS_SIGNED_URL_TTL_SECONDS=3600

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=noreply@example.com
